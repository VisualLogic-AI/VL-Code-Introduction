// VL_VERSION:4.3.0
<App-DashboardApp "root">

# SysConfig
DEVICE_TARGET:"PC"
SCREEN_RESOLUTION:"1920x1080"

# Frontend Global Vars
$isMobile(BOOL) = false

# Frontend Tree
// Single home page: Smart Campus dashboard; switches between PC three-column and mobile single-column by viewport
<Page-Dashboard "dashboardPage"> path:"home"
-<If-Pc> conditions:!$isMobile
--<Section-Dashboard "dashboardInst"> width:"100%" height:"100%"
-<If-Mobile> conditions:$isMobile
--<Section-DashboardMobile "dashboardMobileInst"> width:"100%" height:"100%"

# Frontend Event Handlers
<App-DashboardApp "root">.@init()
-$isMobile = (WINDOW.innerWidth < 768)

# Frontend Internal Methods

# Frontend Pipeline Funcs
</App-DashboardApp>
